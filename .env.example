PORT=3000
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_NAME=Admin
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=choose_a_strong_password

# Supabase > Project Settings > Database > Connection string > URI (use the "Transaction pooler" one).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Product photos in Supabase Storage (optional; blank = saved on the server disk).
# Project Settings > API: Project URL and the service_role key. Keep the key SECRET, server only.
# Create a PUBLIC bucket named "products" in Storage first.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=products

# Razorpay (leave blank to offer Cash on Delivery only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
